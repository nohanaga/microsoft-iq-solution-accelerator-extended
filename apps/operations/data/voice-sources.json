{
  "datasetId": "maikuro-jp-v1",
  "version": "2026-09-10.voices-1",
  "asOf": "2026-07-08T18:00:00+09:00",
  "dataOrigin": "synthetic",
  "entries": [
    { "id": "SUR-001", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-01", "rating": 5, "text": "バニラの香りとクリームの口当たりが好きです。甘さ控えめも選べると嬉しいです。", "topics": ["甘さ控えめ", "香り"], "publishedAt": "2026-06-01T17:00:00+09:00", "analyzedAt": "2026-06-01T18:00:00+09:00", "status": "published" },
    { "id": "SUR-002", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-01", "rating": 4, "text": "水出しの後味がすっきりしています。持ち帰りの氷の量を選べると助かります。", "topics": ["後味", "氷の量"], "publishedAt": "2026-06-05T17:00:00+09:00", "analyzedAt": "2026-06-05T18:00:00+09:00", "status": "published" },
    { "id": "SUR-003", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-02", "rating": 4, "text": "香りは好みですが、午後には甘さ控えめが飲みたいです。シロップを減らせると良いです。", "topics": ["甘さ控えめ", "香り"], "publishedAt": "2026-06-09T17:00:00+09:00", "analyzedAt": "2026-06-09T18:00:00+09:00", "status": "published" },
    { "id": "SUR-004", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-02", "rating": 4, "text": "ミルクとバニラのバランスが良く飲みやすいです。小さいサイズも欲しいです。", "topics": ["サイズ", "口当たり"], "publishedAt": "2026-06-12T17:00:00+09:00", "analyzedAt": "2026-06-12T18:00:00+09:00", "status": "published" },
    { "id": "SUR-005", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-03", "rating": 3, "text": "クリームは好きですが後味に甘さが残ります。甘さ控えめを希望します。", "topics": ["甘さ控えめ", "後味"], "publishedAt": "2026-06-15T17:00:00+09:00", "analyzedAt": "2026-06-15T18:00:00+09:00", "status": "published" },
    { "id": "SUR-006", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-03", "rating": null, "text": "水出しの香りをもっと楽しみたいので、甘さ控えめの選択肢が欲しいです。", "topics": ["甘さ控えめ", "香り"], "publishedAt": "2026-06-18T17:00:00+09:00", "analyzedAt": "2026-06-18T18:00:00+09:00", "status": "published" },
    { "id": "SUR-007", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-04", "rating": 4, "text": "甘さ控えめなら昼食後にも飲みやすいです。水出しの香りは今のまま残してほしいです。", "topics": ["甘さ控えめ", "香り"], "publishedAt": "2026-06-21T17:00:00+09:00", "analyzedAt": "2026-06-21T18:00:00+09:00", "status": "published" },
    { "id": "SUR-008", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-04", "rating": 5, "text": "クリームの口当たりがなめらかです。苦味がやわらかく、後味も好きです。", "topics": ["口当たり", "後味"], "publishedAt": "2026-06-25T17:00:00+09:00", "analyzedAt": "2026-06-25T18:00:00+09:00", "status": "published" },
    { "id": "SUR-009", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-05", "rating": 4, "text": "甘さ控えめで水出しの香りを楽しめる商品も欲しいです。価格は今と同じだと選びやすいです。", "topics": ["甘さ控えめ", "価格"], "publishedAt": "2026-07-01T17:00:00+09:00", "analyzedAt": "2026-07-01T18:00:00+09:00", "status": "published" },
    { "id": "SUR-010", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-05", "rating": 4, "text": "ミルクとクリームのバランスが良いです。氷が溶けても飲みやすいです。", "topics": ["口当たり", "氷の量"], "publishedAt": "2026-07-03T17:00:00+09:00", "analyzedAt": "2026-07-03T18:00:00+09:00", "status": "published" },
    { "id": "SUR-011", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-06", "rating": 5, "text": "バニラの香りが良くて後味も軽いです。持ち帰りでもクリームが楽しめました。", "topics": ["香り", "後味"], "publishedAt": "2026-07-05T17:00:00+09:00", "analyzedAt": "2026-07-05T18:00:00+09:00", "status": "published" },
    { "id": "SUR-012", "source": "survey", "revision": 1, "productId": "PRD-002", "storeId": "STR-06", "rating": 5, "text": "今の甘さも好きですが、甘さ控えめと選べると気分を変えられそうです。香りは残してほしいです。", "topics": ["甘さ控えめ", "香り"], "publishedAt": "2026-07-08T17:00:00+09:00", "analyzedAt": "2026-07-08T17:30:00+09:00", "status": "published" },
    { "id": "SUR-013", "source": "survey", "revision": 1, "productId": "PRD-003", "storeId": "STR-01", "rating": 4, "text": "泡の口当たりがなめらかです。後味に水出しの香りが残ります。", "topics": ["口当たり", "香り"], "publishedAt": "2026-07-02T17:00:00+09:00", "analyzedAt": "2026-07-02T18:00:00+09:00", "status": "published" },
    { "id": "SUR-014", "source": "survey", "revision": 1, "productId": "PRD-003", "storeId": "STR-06", "rating": 5, "text": "泡がきめ細かくて飲みやすいです。苦味と香りのバランスが好きです。", "topics": ["口当たり", "香り"], "publishedAt": "2026-07-04T17:00:00+09:00", "analyzedAt": "2026-07-04T18:00:00+09:00", "status": "published" },
    { "id": "SNS-001", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-01", "rating": null, "text": "バニラクリーム水出し、香りが良かった。甘さ控えめも選べたら通いたい。", "topics": ["甘さ控えめ", "香り"], "publishedAt": "2026-06-03T13:00:00+09:00", "analyzedAt": "2026-06-03T18:00:00+09:00", "status": "published" },
    { "id": "SNS-002", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-01", "rating": null, "text": "散歩の持ち帰りに水出し。クリームとバニラの組み合わせが好き。", "topics": ["香り", "口当たり"], "publishedAt": "2026-06-07T13:00:00+09:00", "analyzedAt": "2026-06-07T18:00:00+09:00", "status": "published" },
    { "id": "SNS-003", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-02", "rating": null, "text": "ランチの後に飲むなら甘さ控えめがいい。バニラの香りはそのままで。", "topics": ["甘さ控えめ", "香り"], "publishedAt": "2026-06-11T13:00:00+09:00", "analyzedAt": "2026-06-11T18:00:00+09:00", "status": "published" },
    { "id": "SNS-004", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-02", "rating": null, "text": "水出しの後味が爽やか。クリームが軽くて飲みやすい。", "topics": ["後味", "口当たり"], "publishedAt": "2026-06-13T13:00:00+09:00", "analyzedAt": "2026-06-13T18:00:00+09:00", "status": "published" },
    { "id": "SNS-005", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-03", "rating": null, "text": "クリームはおいしいけど甘さが強かった。甘さ控えめを選びたい。", "topics": ["甘さ控えめ"], "publishedAt": "2026-06-16T13:00:00+09:00", "analyzedAt": "2026-06-16T18:00:00+09:00", "status": "published" },
    { "id": "SNS-006", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-03", "rating": null, "text": "氷が多いと水出しが薄く感じる。氷の量を選びたい。香りは好み。", "topics": ["氷の量", "香り"], "publishedAt": "2026-06-19T13:00:00+09:00", "analyzedAt": "2026-06-19T18:00:00+09:00", "status": "published" },
    { "id": "SNS-007", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-04", "rating": null, "text": "仕事帰りの水出し。甘さ控えめのバニラがあったら毎日の候補になりそう。", "topics": ["甘さ控えめ"], "publishedAt": "2026-06-23T13:00:00+09:00", "analyzedAt": "2026-06-23T18:00:00+09:00", "status": "published" },
    { "id": "SNS-008", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-04", "rating": null, "text": "予約の受取に待ち時間があったけど、水出しの香りと後味は良かった。", "topics": ["待ち時間", "香り", "後味"], "publishedAt": "2026-06-27T13:00:00+09:00", "analyzedAt": "2026-06-27T18:00:00+09:00", "status": "published" },
    { "id": "SNS-009", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-05", "rating": null, "text": "甘さ控えめで苦味が楽しめるクリーム水出しも飲みたい。価格は気になる。", "topics": ["甘さ控えめ", "価格"], "publishedAt": "2026-07-02T13:00:00+09:00", "analyzedAt": "2026-07-02T18:00:00+09:00", "status": "published" },
    { "id": "SNS-010", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-05", "rating": null, "text": "接客が丁寧で持ち帰りもスムーズ。水出しは香りがよく飲みやすい。", "topics": ["接客", "香り"], "publishedAt": "2026-07-04T13:00:00+09:00", "analyzedAt": "2026-07-04T18:00:00+09:00", "status": "published" },
    { "id": "SNS-011", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-06", "rating": null, "text": "海沿いで水出し。クリームがなめらかでバニラの香りも良かった。", "topics": ["口当たり", "香り"], "publishedAt": "2026-07-06T13:00:00+09:00", "analyzedAt": "2026-07-06T18:00:00+09:00", "status": "published" },
    { "id": "SNS-012", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": "STR-06", "rating": null, "text": "甘さ控えめで後味が軽いものも欲しい。氷は少なめが好み。", "topics": ["甘さ控えめ", "後味", "氷の量"], "publishedAt": "2026-07-08T13:00:00+09:00", "analyzedAt": "2026-07-08T17:00:00+09:00", "status": "published" },
    { "id": "SNS-013", "source": "social", "revision": 1, "productId": "PRD-002", "storeId": null, "rating": null, "text": "舞黒のバニラクリーム水出しが気になる。甘さ控えめもあると嬉しい。", "topics": ["甘さ控えめ"], "publishedAt": "2026-07-07T13:00:00+09:00", "analyzedAt": "2026-07-07T18:00:00+09:00", "status": "published" },
    { "id": "SNS-014", "source": "social", "revision": 1, "productId": "PRD-003", "storeId": "STR-06", "rating": null, "text": "泡仕立て水出しの口当たりがなめらか。苦味がやわらかくて飲みやすい。", "topics": ["口当たり"], "publishedAt": "2026-07-05T13:00:00+09:00", "analyzedAt": "2026-07-05T18:00:00+09:00", "status": "published" }
  ]
}